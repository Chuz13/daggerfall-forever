{
  "id": "duelists-flow",
  "name": "Duelist's Flow",
  "version": "1.0.0",
  "author": "13",
  "description": "Rhythmic combat combo system: consecutive landed strikes build flow, restoring fatigue and focus, while missed swings break rhythm.",
  "enabled": true,
  "locales": "locales.json",
  "entry": "plugin.js",
  "settings": [
    {
      "key": "decaySeconds",
      "type": "number",
      "label": "Combo Decay Timer (seconds)",
      "labelKey": "df.cfg.decaySeconds",
      "min": 3,
      "max": 15,
      "step": 1,
      "default": 6
    },
    {
      "key": "tranceThreshold",
      "type": "number",
      "label": "Trance Unlock Streak",
      "labelKey": "df.cfg.tranceThreshold",
      "min": 5,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "key": "showChip",
      "type": "boolean",
      "label": "Show HUD Status Chip",
      "labelKey": "df.cfg.showChip",
      "default": true
    }
  ]
}

