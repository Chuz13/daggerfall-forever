{
  "id": "stamina-regeneration",
  "name": "Stamina Regeneration",
  "version": "2.0.0",
  "author": "Osmicnosap",
  "description": "Adds continuous passive stamina regeneration, with MCM rate/sprint options, HUD status chip, and 26-language support.",
  "enabled": false,
  "locales": "locales.json",
  "entry": "plugin.js",
  "settings": [
    {
      "key": "regenPerSecond",
      "type": "number",
      "label": "Fatigue Regen / sec",
      "labelKey": "sr.cfg.regenPerSecond",
      "min": 0.5,
      "max": 10,
      "step": 0.5,
      "default": 1
    },
    {
      "key": "pauseWhileRunning",
      "type": "boolean",
      "label": "Pause While Running",
      "labelKey": "sr.cfg.pauseWhileRunning",
      "default": false
    },
    {
      "key": "showChip",
      "type": "boolean",
      "label": "Show HUD Status Chip",
      "labelKey": "sr.cfg.showChip",
      "default": true
    }
  ]
}
